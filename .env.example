# AFLAX Alumni Connections: environment settings
#
# The app reads .env from this repository's folder first, then from the folder ABOVE it.
# Copy this file to .env and fill in a value, or rely on a .env in the parent folder.
# Blank values are ignored, so an unfilled copy never hides a key in the parent folder.
# NEVER commit a real .env.

# ---- Required for Falcon Mentor (set ONE of these; exact names) ----
PORTKEY_API_KEY=
OPENAI_API_KEY=

# ---- Optional ----
# ADMIN_PASSWORD=          # generic board admin (admin@aflax.example); random if unset
# OPENAI_MODEL=gpt-6-luna
# CHAT_DAILY_LIMIT=40
# CHAT_PER_MINUTE_LIMIT=6
# APP_URL=http://localhost:8001

# Real email (otherwise emails are saved to backend/data/outbox/)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=

# Token prices in USD per 1M tokens (enables estimated cost on the usage dashboard)
# PRICE_INPUT_PER_M=0.10
# PRICE_CACHED_INPUT_PER_M=
# PRICE_OUTPUT_PER_M=0.50
